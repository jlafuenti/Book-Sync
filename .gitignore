# Workspace file
*.code-workspace

# Node modules
node_modules/

# Test / coverage output
coverage/
*.local

# Python
__pycache__/
*.pyc
*.pyo
.env
venv/
.venv/
# Stray virtualenvs that have been created inside server/tests/ before. They sit
# under pytest's `testpaths`, so an uncommitted one gets walked during collection
# (see the norecursedirs guard in server/pytest.ini).
server/tests/booksync-testenv*/

# Test / coverage artifacts
.coverage
coverage.xml
.pytest_cache/

# Docker
*.log
# Real deployment compose file (secrets, volume paths) — copy from
# docker-compose.example.yml and customize; never tracked.
#
# The `.*` sibling rule is not paranoia: #187 fenced `*.bak`, and the production
# host was then found holding `docker-compose.yml.pre-151` — same five secret
# lines, matched by nothing (issue #313). Enumerating suffixes loses to whatever
# a human types next, so ignore the whole stem. `docker-compose.example.yml` is a
# different stem and stays tracked.
/docker-compose.yml
/docker-compose.yml.*

# Real Jetson deployment compose file (carries TRANSCRIPTION_API_KEY) — copy
# from jetson/docker-compose.example.yml and customize; never tracked.
/jetson/docker-compose.yml
/jetson/docker-compose.yml.*

# The real reverse-proxy config. docs/operations.md tells operators to copy
# Caddyfile.example and adapt it, so the documented setup produces a file here
# holding whatever credentials the proxy fronts with — and nothing matched it.
# The negation must stay last, or the template a fresh clone copies from stops
# being committable (issue #313).
/Caddyfile
/Caddyfile.*
!Caddyfile.example

# Databases (local SQLite files must never be committed — issue #153)
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# OS files
.DS_Store
Thumbs.db

# Playwright screenshots from planning/debugging
*.png
# ...but the PWA icons are real assets (issue #62, docs/web-pwa.md)
!web/public/*.png
# ...and so are the README screenshots (issue #185)
!docs/images/*.png

# IDE
.vscode/
.idea/
.claude/settings.local.json

# Local Claude Code secrets (URL/login for the live UI) — CLAUDE.md itself is tracked
CLAUDE.local.md

# Build outputs
web/dist/
web/build/

# Data directories (runtime)
data/
# But allow Android source files that live under a 'data' package path
!android/app/src/**/data/
!android/app/src/**/data/**

# Android Gradle cache and build output (incl. Kover coverage reports)
android/.gradle/
android/.kotlin/
android/build/
android/app/build/

# Android build outputs
android/app/build/
android/build/
android/local.properties
android/captures/
android/.externalNativeBuild/

# Sync-parity fixtures copied from server/ at build time (single source of truth is the server)
android/app/src/test/resources/sync_parity/

# Playwright MCP snapshots/screenshots
.playwright-mcp/

# Agent-workflow plans and specs. Five of these shipped under docs/ as if they
# were documentation, describing work that had already landed and contradicting
# the current testing rules (issue #241). Plans belong in the issue/PR; docs/ is
# for documentation. Pinned from the other side by
# server/tests/test_docs_contract.py.
docs/superpowers/

# Backup/scratch copies of config files carry exactly the same secrets as the
# original, but the rules above match `/docker-compose.yml` and `.env` by name
# only (issue #187). One `git add -A` is all it takes.
*.bak
*.orig
*~

# Environment files of every flavour. `.env` above is an exact-name rule, so
# `.env.prod`, `.env.production` and friends slipped through.
.env.*
# ...but the templates a fresh clone copies from must stay tracked.
!.env.example
!.env.sample
!.env.template
# Deliberately NOT excepted: .env.production and .env.development. Vite treats
# those as ordinary build config and they are often committed, but they are just
# as often where a key ends up. If a build genuinely needs one, add the negation
# in the same commit that adds the file, so the decision is visible in review.

# Signing material — never in git. The Play upload keystore in particular is
# unrecoverable if leaked: it cannot be rotated without Google's help.
*.jks
*.keystore
*.p12
*.pem
*.key
