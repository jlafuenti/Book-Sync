# Compose interpolation values. Copy this file next to docker-compose.yml and
# fill in the value below:
#
#   cp .env.example .env
#
# `.env` is gitignored; `.env.example` is deliberately excepted from that rule
# (see .gitignore), so this template stays tracked and your real secret never
# does.

# Password for the `booksync` Postgres role. docker-compose.yml interpolates it
# twice — into the db service's POSTGRES_PASSWORD and into the server service's
# DATABASE_URL — so setting it here keeps the two in sync.
#
# Leaving it unset is NOT harmless: compose substitutes an empty string,
# postgres:16-alpine refuses to initialise without a password, and the stack
# never comes up. It is also only applied on the first init of the booksync_db
# volume — see docs/operations.md, "Rotating the Postgres password", for an
# already-initialized deployment.
#
# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=

# ---------------------------------------------------------------------------
# Container user (issue #180)
#
# The `server` and `web` containers run as an unprivileged uid:gid rather than
# root, via `user: "${PUID:-1000}:${PGID:-1000}"` in docker-compose.yml. Unlike
# the password above these have working defaults, so leaving them blank/absent
# is fine — compose falls back to 1000:1000.
#
# Set them when your library, app-data or backups directories are owned by some
# other uid. Find it with:
#   stat -c '%u:%g' /path/to/your/ebooks
#
# Whatever you pick has to be able to write /data/app, /data/imports, /backups
# and both library roots. On an existing install that means a one-time
# ownership change — read docs/operations.md, "Running as a non-root user",
# before restarting, because the server refuses to start if it cannot create
# its log directory under the app-data mount.
#
# `db` is not affected: the postgres image manages its own user.
PUID=1000
PGID=1000
