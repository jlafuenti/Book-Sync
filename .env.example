# Compose interpolation values. Copy this file next to docker-compose.yml and
# fill in the value below:
#
#   cp .env.example .env
#
# `.env` is gitignored; `.env.example` is deliberately excepted from that rule
# (see .gitignore), so this template stays tracked and your real secret never
# does.

# Password for the `booksync` Postgres role. docker-compose.yml interpolates it
# twice — into the db service's POSTGRES_PASSWORD and into the server service's
# DATABASE_URL — so setting it here keeps the two in sync.
#
# Leaving it unset is NOT harmless: compose substitutes an empty string,
# postgres:16-alpine refuses to initialise without a password, and the stack
# never comes up. It is also only applied on the first init of the booksync_db
# volume — see docs/operations.md, "Rotating the Postgres password", for an
# already-initialized deployment.
#
# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=
