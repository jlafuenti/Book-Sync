# Compose interpolation values — the handful of settings compose itself has to
# resolve before any container exists, so they cannot come from a docker secret.
# Copy this file next to docker-compose.yml:
#
#   cp .env.example .env
#
# `.env` is gitignored; `.env.example` is deliberately excepted from that rule
# (see .gitignore), so this template stays tracked and your real secret never
# does.

# ---------------------------------------------------------------------------
# Secrets do NOT belong here any more (issue #180)
#
# The JWT signing key, the credential encryption keys and the Postgres password
# are file-backed docker secrets: they live one-per-file under `secrets/`, and
# docker-compose.yml mounts them at /run/secrets/<name>. A value in `.env` ends
# up in the container's environment, where `docker inspect` and /proc/1/environ
# hand it to anyone in the `docker` group. See `secrets/README.md` for the three
# files and the commands that create them.
#
# Password for the `booksync` Postgres role. Leave it BLANK unless you have
# deliberately taken the plain-environment path documented in
# docker-compose.example.yml — the shipped template reads the password from
# `secrets/postgres_password` and interpolates nothing here.
#
# If you do take that path, this is interpolated twice: into the db service's
# POSTGRES_PASSWORD and into the server's DATABASE_URL, so setting it here keeps
# the two in sync. It is only applied on the first init of the booksync_db
# volume either way — see docs/operations.md, "Rotating the Postgres password",
# for an already-initialized deployment.
#
# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=

# ---------------------------------------------------------------------------
# Container user (issue #180)
#
# The `server` and `web` containers run as an unprivileged uid:gid rather than
# root, via `user: "${PUID:-1000}:${PGID:-1000}"` in docker-compose.yml. Unlike
# the password above these have working defaults, so leaving them blank/absent
# is fine — compose falls back to 1000:1000.
#
# Set them when your library, app-data or backups directories are owned by some
# other uid. Find it with:
#   stat -c '%u:%g' /path/to/your/ebooks
#
# Whatever you pick has to be able to write /data/app, /data/imports, /backups
# and both library roots. On an existing install that means a one-time
# ownership change — read docs/operations.md, "Running as a non-root user",
# before restarting, because the server refuses to start if it cannot create
# its log directory under the app-data mount.
#
# `db` is not affected: the postgres image manages its own user.
PUID=1000
PGID=1000
