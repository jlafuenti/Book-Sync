<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Main Content Container -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <!-- Hosts the hidden page counter (issue #730): a PageCounterWebView,
         added in code and sized to the live reader WebView, laid out beneath
         the book so it never draws over it or takes a touch. -->
    <FrameLayout
        android:id="@+id/page_counter_host"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false"
        android:importantForAccessibility="noHideDescendants" />

    <!-- EPUB Content -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/navigator_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top overlay bar -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#CC000000"
        android:visibility="gone">

        <!-- Spacer for status bar -->
        <View
            android:id="@+id/status_bar_spacer"
            android:layout_width="match_parent"
            android:layout_height="0dp" />

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:titleTextColor="@android:color/white"
            app:navigationIconTint="@android:color/white" />
    </LinearLayout>

    <!-- Bottom overlay bar -->
    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="#CC000000"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:visibility="gone">

        <!-- Progress text -->
        <!-- Tap to cycle percent / pages / chapter / time (issue #730) -->
        <TextView
            android:id="@+id/progress_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground"
            android:textColor="@android:color/white"
            android:textSize="13sp"
            android:gravity="center"
            android:text="Loading..." />

        <!-- Progress slider -->
        <SeekBar
            android:id="@+id/progress_slider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="1000"
            android:progressTint="@android:color/white"
            android:thumbTint="@android:color/white" />

        <!-- Spacer for navigation bar -->
        <View
            android:id="@+id/nav_bar_spacer"
            android:layout_width="match_parent"
            android:layout_height="0dp" />
    </LinearLayout>

    <!-- Hosts ReaderOverlays (issue #597 Track C): TranscriptionStatusDialog
         (issue #536) and, while the walkthrough is running a Reader/Player
         step, TourOverlay. Empty (nothing pending, no tour step here) renders
         nothing and passes touches through to the views below it. -->
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/overlay_host"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
