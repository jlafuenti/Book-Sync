<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Tab bar -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:tabMode="fixed"
        app:tabGravity="fill"
        app:tabIndicatorColor="?attr/colorPrimary"
        app:tabTextColor="?android:attr/textColorSecondary"
        app:tabSelectedTextColor="?attr/colorPrimary">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Text" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Display" />
    </com.google.android.material.tabs.TabLayout>

    <!-- Content switcher -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <!-- ======== TEXT TAB content ======== -->
        <LinearLayout
            android:id="@+id/tab_text_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible">

            <!-- Font Family -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Font"
                android:textSize="13sp"
                android:textColor="?android:attr/textColorSecondary"
                android:layout_marginBottom="12dp" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/font_family_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                app:selectionRequired="true"
                android:layout_marginBottom="24dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_font_system"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="48dp"
                    android:text="Aa"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_font_serif"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="48dp"
                    android:text="Aa"
                    android:textSize="15sp"
                    android:fontFamily="serif"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_font_sans"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="48dp"
                    android:text="Aa"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!-- Font Size -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Font Size"
                android:textSize="13sp"
                android:textColor="?android:attr/textColorSecondary"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_font_decrease"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:text="A"
                    android:textSize="14sp"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp" />

                <TextView
                    android:id="@+id/text_font_size"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="100%"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:gravity="center" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_font_increase"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:text="A"
                    android:textSize="20sp"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp" />

                <ImageButton
                    android:id="@+id/btn_font_reset"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_restore_24"
                    app:tint="?attr/colorPrimary" />
            </LinearLayout>

            <!-- Line Spacing -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Line Spacing"
                android:textSize="13sp"
                android:textColor="?android:attr/textColorSecondary"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_spacing_decrease"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    app:icon="@drawable/ic_spacing_compact"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp" />

                <TextView
                    android:id="@+id/text_spacing"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="1.2x"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:gravity="center" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_spacing_increase"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    app:icon="@drawable/ic_spacing_wide"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp" />

                <ImageButton
                    android:id="@+id/btn_spacing_reset"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_restore_24"
                    app:tint="?attr/colorPrimary" />
            </LinearLayout>

            <!-- Margins -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Margins"
                android:textSize="13sp"
                android:textColor="?android:attr/textColorSecondary"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_margin_decrease"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    app:icon="@drawable/ic_margin_narrow"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp" />

                <TextView
                    android:id="@+id/text_margins"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="1.0x"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:gravity="center" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_margin_increase"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    app:icon="@drawable/ic_margin_wide"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp" />

                <ImageButton
                    android:id="@+id/btn_margin_reset"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_restore_24"
                    app:tint="?attr/colorPrimary" />
            </LinearLayout>

        </LinearLayout>

        <!-- ======== DISPLAY TAB content ======== -->
        <LinearLayout
            android:id="@+id/tab_display_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Theme"
                android:textSize="13sp"
                android:textColor="?android:attr/textColorSecondary"
                android:layout_marginBottom="16dp" />

            <!-- Theme selector — 3 color-coded cards -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <!-- Light theme preview card -->
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp">
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btn_theme_light"
                        android:layout_width="match_parent"
                        android:layout_height="100dp"
                        app:cardBackgroundColor="#FFFFFF"
                        app:strokeWidth="1dp"
                        app:strokeColor="#E0E0E0"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        android:clickable="true"
                        android:focusable="true">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="Aa"
                            android:textSize="20sp"
                            android:textColor="#1C1C1E"
                            android:gravity="center" />
                    </com.google.android.material.card.MaterialCardView>
                    <ImageView
                        android:id="@+id/check_theme_light"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@android:drawable/checkbox_on_background"
                        android:layout_gravity="top|end"
                        android:layout_margin="6dp"
                        android:visibility="gone"
                        app:tint="?attr/colorPrimary" />
                </FrameLayout>

                <!-- Sepia theme preview card -->
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp">
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btn_theme_sepia"
                        android:layout_width="match_parent"
                        android:layout_height="100dp"
                        app:cardBackgroundColor="#F5E6C8"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        android:clickable="true"
                        android:focusable="true">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="Aa"
                            android:textSize="20sp"
                            android:textColor="#5B4636"
                            android:gravity="center" />
                    </com.google.android.material.card.MaterialCardView>
                    <ImageView
                        android:id="@+id/check_theme_sepia"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@android:drawable/checkbox_on_background"
                        android:layout_gravity="top|end"
                        android:layout_margin="6dp"
                        android:visibility="gone"
                        app:tint="?attr/colorPrimary" />
                </FrameLayout>

                <!-- Dark theme preview card -->
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content">
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btn_theme_dark"
                        android:layout_width="match_parent"
                        android:layout_height="100dp"
                        app:cardBackgroundColor="#1C1C1E"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        android:clickable="true"
                        android:focusable="true">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="Aa"
                            android:textSize="20sp"
                            android:textColor="#FFFFFF"
                            android:gravity="center" />
                    </com.google.android.material.card.MaterialCardView>
                    <ImageView
                        android:id="@+id/check_theme_dark"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@android:drawable/checkbox_on_background"
                        android:layout_gravity="top|end"
                        android:layout_margin="6dp"
                        android:visibility="gone"
                        app:tint="?attr/colorPrimary" />
                </FrameLayout>

            </LinearLayout>
        </LinearLayout>

    </FrameLayout>
</LinearLayout>
