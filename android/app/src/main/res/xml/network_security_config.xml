<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow cleartext HTTP for local development servers -->
    <domain-config cleartextTrafficPermitted="true">
        <!-- Android emulator loopback to host -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <!-- localhost for physical device testing -->
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <!-- Local network (for physical device to host PC) -->
        <domain includeSubdomains="false">REDACTED</domain>
    </domain-config>
</network-security-config>
