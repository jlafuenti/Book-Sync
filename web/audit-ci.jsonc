{
  // Allow-list for the `npm audit` CI gate (web-tests.yml). npm audit has no
  // native ignore mechanism, so CI runs audit-ci with this config: any
  // advisory in PRODUCTION dependencies that is not listed here fails the
  // build. Dev-only deps (vite, vitest, eslint...) never ship to the browser
  // and are excluded via skip-dev.
  //
  // Every entry needs a justification and should be re-checked when the
  // owning dependency is next touched. See issue #157.
  "low": true,
  "skip-dev": true,
  "allowlist": [
    // ---- @xmldom/xmldom <=0.8.12, via epubjs 0.3.x -------------------------
    // The only npm "fix" is epubjs@0.4.2 — an old alpha and a breaking
    // downgrade. xmldom here parses the user's OWN EPUB files client-side in
    // the reader; it is not a server-side surface, and a malicious book could
    // at worst disrupt the reader tab rendering it. Re-evaluate when epubjs
    // ships a release off xmldom 0.8.
    "GHSA-wh4c-j3r5-mjhp", // XML injection via unsafe CDATA serialization
    "GHSA-2v35-w6hq-6mfw", // uncontrolled recursion in XML serialization (DoS)
    "GHSA-f6ww-3ggp-fr8h", // XML injection via DocumentType serialization
    "GHSA-x6wf-f3px-wcqx", // node injection via processing-instruction serialization
    "GHSA-j759-j44w-7fr8", // node injection via comment serialization
    // ---- react-router 6.x (fix is the breaking 7.18 major) -----------------
    // GHSA-337j-9hxr-rhxg is SSR-only (deserializeErrors in hydration); this
    // app is a pure client-side Vite SPA with no SSR, so the code path is
    // unreachable. GHSA-wrjc-x8rr-h8h6 is an open redirect via a backslash in
    // <Link>/useNavigate targets; all navigation targets in this app are
    // internal constants, never attacker-controlled. Both fixed by the
    // react-router 7 migration — tracked as follow-up work, out of scope for
    // the dependency-bump PR.
    "GHSA-337j-9hxr-rhxg",
    "GHSA-wrjc-x8rr-h8h6"
  ]
}
