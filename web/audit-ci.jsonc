{
  // Allow-list for the `npm audit` CI gate (web-tests.yml). npm audit has no
  // native ignore mechanism, so CI runs audit-ci with this config: any
  // advisory in PRODUCTION dependencies that is not listed here fails the
  // build. Dev-only deps (vite, vitest, eslint...) never ship to the browser
  // and are excluded via skip-dev.
  //
  // Every entry needs a justification and should be re-checked when the
  // owning dependency is next touched. See issue #157.
  "low": true,
  "skip-dev": true,
  // Empty on purpose. Every entry needs a written justification and should be
  // re-checked when the owning dependency is next touched (issue #157).
  //
  // Six @xmldom/xmldom <=0.8.14 advisories (via epubjs 0.3.x) used to be listed
  // here. They were written before an npm `overrides` entry lifted the package
  // to 0.8.15, where they are fixed (#447), and outlived it: an allow-list entry
  // for a version no longer installed would hide the vulnerable parser if the
  // override were ever dropped. `npm audit --omit=dev` is clean without them, so
  // they are removed, and web/src/dependency-pins.test.js pins the override.
  "allowlist": []
}
